WorldInfo {
  info [
    "DJI Mavic 2 PRO x2 (ArduPilot SITL) - dual drone collaborative lifting model."
    "Payload: 32-seg rope (2.0 m, ~0.05 kg) + 0.5 kg load (6x volume)."
    "Both drones locked mid-air at t0; ball ~0.09 m above ground; no ground pillars."
    "Launch ArduPilot SITL in WSL first, then run this simulation."
    "In MAVProxy: mode GUIDED -> arm throttle force -> takeoff 10"
  ]
  title "DJI Mavic 2 PRO x2 - ArduPilot SITL"
  ERP 0.8
  basicTimeStep 2
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
